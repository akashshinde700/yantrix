# ─────────────────────────────────────────────────────────────
# Yantrix Technology — environment variables
# Copy this file to `.env` (never commit `.env`).
# ─────────────────────────────────────────────────────────────

# ── Required in production ────────────────────────────────────
# Secret used to sign admin session cookies AND to hash sign-in codes at rest.
# There is NO production fallback: without it the app refuses to sign sessions.
# Generate one with:  openssl rand -base64 48
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# First owner account. Created on the first login attempt when no admin exists.
# In production these MUST be set — no default account is created without them.
# In development they are optional and the documented default is used.
# ADMIN_NAME=Site Owner
# ADMIN_EMAIL=owner@yantrixtechnology.com
# ADMIN_PASSWORD=choose-a-long-password

# ── Database ──────────────────────────────────────────────────
# MySQL connection (database must exist; tables are created automatically).
DATABASE_URL=mysql://root:root@localhost:3306/yantrix

# Where content, enquiries and admin accounts live:
#   auto  (default) MySQL, falling back to ./data JSON files when the database
#                   is unreachable (fresh checkout, CI, offline preview)
#   mysql           MySQL only — database errors are fatal (use in production)
#   json            JSON files only, no database needed
# CONTENT_STORE=mysql

# ── Email (required in production) ────────────────────────────
# Every SMTP mailbox works. Examples:
#   Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  (SMTP_PASS = a 16-character App Password,
#                             created at myaccount.google.com → Security → 2-Step Verification → App passwords)
#   Hostinger:                SMTP_HOST=smtp.hostinger.com  SMTP_PORT=465
#   Zoho Mail (India):        SMTP_HOST=smtp.zoho.in  SMTP_PORT=465
#
# Without these the site still saves enquiries, but:
#   - no confirmation / alert emails are sent, and
#   - admin sign-in fails, because the one-time code cannot be delivered.
#     (In development the code is printed to the server terminal instead.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=info@yantrixtechnology.com
# SMTP_PASS=your-app-password
# Optional:
# MAIL_FROM="Yantrix Technology <info@yantrixtechnology.com>"
# ADMIN_NOTIFY_EMAIL=info@yantrixtechnology.com,owner@example.com

# ── Proxies ───────────────────────────────────────────────────
# The rate limiters identify clients from X-Forwarded-For (rightmost hop) or
# X-Real-IP. Set this to "false" when the app is exposed directly to the
# internet with no reverse proxy, so a client cannot spoof those headers.
# TRUST_PROXY_HEADERS=true

# ── Optional ──────────────────────────────────────────────────
# Where the JSON store keeps its files (default: ./data)
# DATA_DIR=/var/lib/yantrix
#
# Extra dev-server origins allowed to load the app through a tunnel/proxy
# (comma-separated). *.e2b.app, *.arena.ai and *.ngrok-free.app are built in.
# ALLOWED_DEV_ORIGINS=my-preview.example.com
